class Solution {
public:
    int trap(vector<int>& height) {
        int n = height.size();
        if (n == 0) return 0;    // empty set
        vector<int> pre(n);      // previous max element
        vector<int> post(n);     // post max element

        // for previous greatest element
        pre[0] = height[0];
        for (int i = 1; i < n; i++) {
            pre[i] = max(pre[i - 1], height[i]);
        }

        // for post greatest element
        post[n - 1] = height[n - 1];
        for (int i = n - 2; i >= 0; i--) {
            post[i] = max(post[i + 1], height[i]);
        }

        // calculating water
        int water = 0;
        for (int i = 0; i < n; i++) {
            water += min(pre[i], post[i]) - height[i];
        }   
        return water;
    }
};
